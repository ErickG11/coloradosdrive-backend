# Entorno de ejecución: development | test | production
NODE_ENV=development

# Usar true en local para desactivar los crons de prácticas y solicitudes.
# Sin valor (o sin la variable), los crons mantienen el comportamiento habitual.
DISABLE_CRON=

# Puerto en el que escucha el servidor Express
PORT=3000

# URL del frontend permitida por CORS (nunca usar "*")
FRONTEND_URL=http://localhost:5173

# --- Supabase ---
# URL del proyecto Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key: clave privilegiada, bypassea Row Level Security.
# Solo se usa en el backend. NUNCA exponerla al frontend ni commitearla.
SUPABASE_SERVICE_ROLE_KEY=

# Anon/public key: clave pública, respeta Row Level Security.
SUPABASE_ANON_KEY=

# No hay variable para el JWT secret: los JWT de sesión de Supabase Auth se
# verifican contra el JWKS público del proyecto (derivado de SUPABASE_URL,
# ver src/middlewares/auth.middleware.ts), no contra un secreto compartido.
# El "Legacy JWT secret" del dashboard solo sirve para las API keys legacy
# (anon/service_role), no para tokens de sesión de usuarios.

# --- Correo ---
# smtp (por defecto) | console (solo pruebas locales, sin credenciales).
# console está prohibido con NODE_ENV=production o RAILWAY_ENVIRONMENT presente.
EMAIL_PROVIDER=smtp
# Gmail SMTP vía Nodemailer:
# Cuenta Gmail que envía todos los correos (bienvenida, exámenes, horarios,
# códigos de verificación). Requiere verificación en 2 pasos y una
# "contraseña de aplicación" (NO la contraseña normal de la cuenta).
EMAIL_USER=
EMAIL_APP_PASSWORD=
# En console se omiten EMAIL_USER y EMAIL_APP_PASSWORD. Los mensajes completos,
# incluidos códigos y contraseñas temporales, aparecen en la terminal local.
# Contacto del aviso de privacidad: EMAIL_USER por defecto; en console sin
# EMAIL_USER usa privacidad@example.invalid (ficticio, no recibe mensajes).
PRIVACY_CONTACT_EMAIL=

# --- Correo por API de Gmail (B3 · F42) ---
# EMAIL_PROVIDER=gmail_api envía por HTTPS (sin SMTP; para Railway). Requiere
# EMAIL_USER (cuenta remitente) y las tres credenciales OAuth de abajo; el
# refresh token debe haberse emitido con el alcance gmail.send.
# Un invalid_grant indica token revocado o vencido: generar uno nuevo.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Solicitudes de inscripción online ---
# Secreto para firmar (HS256) el token temporal del flujo de solicitudes.
# Distinto del JWT de Supabase Auth. Mínimo 32 caracteres aleatorios, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SOLICITUD_TOKEN_SECRET=

# --- Flujo final (activar con las fases completas; nunca aplicar solo 042/043) ---
PRIVACY_NOTICE_VERSION=2026-11-borrador-v1
TERMS_VERSION=2026-11-borrador-v1
# Texto plano, borrador sujeto a revisión legal. Vacío usa texto neutro del servidor.
TERMS_REFUND_TEXT=
RECENT_GRAD_MONTHS=12
ENROLLMENT_CODES_DAILY_CAP=250
ENROLLMENT_NEW_REQUESTS_DAILY_CAP=150
ENROLLMENT_UPLOADS_DAILY_CAP=40
ENROLLMENT_UPLOADS_PER_IP_DAILY_CAP=5
ENROLLMENT_CODES_PER_IP_HOUR=60
ENROLLMENT_CODES_PER_EMAIL_DAILY_CAP=5
ENROLLMENT_FAILED_CODES_PER_EMAIL_DAILY_CAP=10
ENROLLMENT_CODE_COOLDOWN_SECONDS=60
# Railway: un proxy conocido. Desarrollo: no confiar en X-Forwarded-For.
# Si se omite: 1 production, 0 development/test. Nunca usar true ni confiar en toda la cadena.
TRUST_PROXY_HOPS=0
# Opcional: secreto dedicado >=32 caracteres. Vacío deriva la clave HMAC
# desde SOLICITUD_TOKEN_SECRET con contexto separado en el servicio de límites.
ENROLLMENT_RATE_HMAC_SECRET=
ADMIN_MFA_REQUIRED=false
# off solo para desarrollo. En producción turnstile exige ambas claves reales;
# el backend rechaza off y las claves públicas de prueba de Cloudflare.
CAPTCHA_PROVIDER=off
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Recuperación de reclamos de aprobación (minutos; cron cada5 minutos)
APPROVAL_CLAIM_TTL_MINUTES=10

# Alumno aprobado: reservas de horario, sin credenciales nuevas (solo backend).
RESERVA_TTL_MINUTES=15
RESERVA_MAX_EXTENSIONES=1
RESERVA_EXTENSION_MINUTES=10
RESERVA_MAX_POR_DIA=3
PAGO_GRACIA_MINUTES=10
COHORT_MARGIN_DAYS=5

# Pagos locales: simulado solo fuera de production. Producción: manual o kushki.
PAYMENT_PROVIDER=simulado
PAYMENT_SURCHARGE_CENTS=0
# Solo se requieren si PAYMENT_PROVIDER=kushki; obtener credenciales propias de UAT.
KUSHKI_ENVIRONMENT=uat
KUSHKI_PUBLIC_KEY=
KUSHKI_PRIVATE_KEY=
KUSHKI_WEBHOOK_SECRET=
KUSHKI_MERCHANT_ID=
