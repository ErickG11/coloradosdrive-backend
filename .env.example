# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto en el que escucha el servidor Express
PORT=3000

# URL del frontend permitida por CORS (nunca usar "*")
FRONTEND_URL=http://localhost:5173

# --- Supabase ---
# URL del proyecto Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key: clave privilegiada, bypassea Row Level Security.
# Solo se usa en el backend. NUNCA exponerla al frontend ni commitearla.
SUPABASE_SERVICE_ROLE_KEY=

# Anon/public key: clave pública, respeta Row Level Security.
SUPABASE_ANON_KEY=

# JWT secret del proyecto Supabase (Project Settings > API > JWT Settings),
# usado para verificar la firma de los JWT emitidos por Supabase Auth.
SUPABASE_JWT_SECRET=

# --- SMTP (correo de bienvenida al matricular) ---
# Configuración genérica vía Nodemailer. En este proyecto apunta a Resend
# por SMTP (https://resend.com/docs/send-with-smtp), pero funciona con
# cualquier proveedor SMTP estándar.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
# Dirección remitente: debe ser de un dominio verificado en el proveedor
# SMTP (o la dirección de pruebas onboarding@resend.dev en Resend).
SMTP_FROM=
