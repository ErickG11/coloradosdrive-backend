# Entorno de ejecución: development | test | production
NODE_ENV=development

# Usar true en local para desactivar los crons de prácticas y solicitudes.
# Sin valor (o sin la variable), los crons mantienen el comportamiento habitual.
DISABLE_CRON=

# Puerto en el que escucha el servidor Express
PORT=3000

# URL del frontend permitida por CORS (nunca usar "*")
FRONTEND_URL=http://localhost:5173

# --- Supabase ---
# URL del proyecto Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key: clave privilegiada, bypassea Row Level Security.
# Solo se usa en el backend. NUNCA exponerla al frontend ni commitearla.
SUPABASE_SERVICE_ROLE_KEY=

# Anon/public key: clave pública, respeta Row Level Security.
SUPABASE_ANON_KEY=

# No hay variable para el JWT secret: los JWT de sesión de Supabase Auth se
# verifican contra el JWKS público del proyecto (derivado de SUPABASE_URL,
# ver src/middlewares/auth.middleware.ts), no contra un secreto compartido.
# El "Legacy JWT secret" del dashboard solo sirve para las API keys legacy
# (anon/service_role), no para tokens de sesión de usuarios.

# --- Correo ---
# smtp (por defecto) | console (solo pruebas locales, sin credenciales).
# console está prohibido con NODE_ENV=production o RAILWAY_ENVIRONMENT presente.
EMAIL_PROVIDER=smtp
# Gmail SMTP vía Nodemailer:
# Cuenta Gmail que envía todos los correos (bienvenida, exámenes, horarios,
# códigos de verificación). Requiere verificación en 2 pasos y una
# "contraseña de aplicación" (NO la contraseña normal de la cuenta).
EMAIL_USER=
EMAIL_APP_PASSWORD=
# En console se omiten EMAIL_USER y EMAIL_APP_PASSWORD. Los mensajes completos,
# incluidos códigos y contraseñas temporales, aparecen en la terminal local.
# Contacto del aviso de privacidad: EMAIL_USER por defecto; en console sin
# EMAIL_USER usa privacidad@example.invalid (ficticio, no recibe mensajes).
PRIVACY_CONTACT_EMAIL=

# --- Solicitudes de inscripción online ---
# Secreto para firmar (HS256) el token temporal del flujo de solicitudes.
# Distinto del JWT de Supabase Auth. Mínimo 32 caracteres aleatorios, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SOLICITUD_TOKEN_SECRET=
